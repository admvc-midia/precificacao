// Precificaragao — schema de precificacao, engenharia de cardapio e compras.
//
// Convencao de dinheiro: todos os valores monetarios sao Decimal(12,4) no banco
// e convertidos para `number` na fronteira (src/lib/mappers.ts). A biblioteca de
// calculo (src/lib/pricing) trabalha apenas com `number` puro.
//
// Convencao de quantidade: toda quantidade persistida em campos *Base esta na
// unidade base do insumo (G, ML ou UN). Conversoes em src/lib/units.ts.

// Prisma 7: o cliente e gerado para dentro de `src/` (importa-se de
// `@/generated/prisma/client`) e fala com o Postgres pelo adaptador `pg`,
// configurado em `src/lib/db.ts`. A pasta gerada nao vai para o git.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// As tabelas e os campos, para a copia completa e o restauro (o cliente do
// Prisma 7 ja nao os traz). Ver tools/gerador-modelo.mjs.
generator modelo {
  provider = "node tools/gerador-modelo.mjs"
  output   = "../src/generated/modelo.ts"
}

// O endereco da base esta em `prisma.config.ts` (linha de comandos) e em
// `src/lib/db.ts` (aplicacao), ambos a partir do DATABASE_URL.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Insumo alimenticio x embalagem/descartavel.
enum IngredientCategory {
  FOOD
  PACKAGING
}

/// Unidade em que o insumo e comprado.
enum PurchaseUnit {
  KG
  G
  L
  ML
  UN
}

/// Unidade base de consumo. KG/G -> G, L/ML -> ML, UN -> UN.
enum BaseUnit {
  G
  ML
  UN
}

/// BASE = preparacao intermediaria (molho, massa). PRODUCT = item de venda.
enum RecipeKind {
  BASE
  PRODUCT
}

/// O preco de menu ja inclui IVA (tipico em PT/BR) ou o IVA e acrescido.
enum VatMode {
  INCLUDED
  ADDED
}

enum ChannelKind {
  COUNTER
  OWN_DELIVERY
  PLATFORM
}

/// Como o preco de venda do produto e definido.
enum PricingMode {
  TARGET_CMV
  TARGET_MARGIN
  MANUAL
}

/// Arredondamento psicologico aplicado ao preco sugerido.
enum RoundingStrategy {
  NONE
  NEAREST_05
  NEAREST_10
  ENDING_90
  ENDING_95
}

/// O que fez o estoque mexer.
enum MovementKind {
  /// Entrada por compra recebida.
  PURCHASE
  /// Saida por producao executada.
  PRODUCTION
  /// Saida por quebra, estrago ou validade.
  WASTE
  /// Saida para amostra, evento ou divulgacao: saiu do armazem mas nao houve
  /// venda. Separado da producao normal porque somar isto ao CMV faria
  /// procurar desperdicio onde ha marketing.
  PROMO
  /// Correcao manual, sem contagem.
  ADJUSTMENT
  /// Correcao vinda de uma contagem de inventario.
  INVENTORY
}

/// Origem de uma cotacao de preco de insumo.
enum QuoteSource {
  MANUAL
  CSV
  CONTINENTE
  PINGO_DOCE
  AUCHAN
  OTHER
}

// ---------------------------------------------------------------------------
// Modulo 5 — Configuracoes globais
// ---------------------------------------------------------------------------

/// Linha unica (id = "default"). Guarda a moeda e todas as variaveis globais
/// de precificacao.
model Settings {
  id       String @id @default("default")
  /// Codigo ISO 4217: EUR, BRL, USD...
  currency String @default("EUR")
  /// BCP 47, define separador decimal e posicao do simbolo: pt-PT, pt-BR...
  locale   String @default("pt-PT")

  /// IVA/imposto sobre a receita. 0.13 = 13% (restauracao em Portugal).
  vatRate Decimal @default(0.13) @db.Decimal(12, 4)
  vatMode VatMode @default(INCLUDED)

  /// Custos fixos + mao de obra + energia, como fracao da receita liquida.
  fixedCostRate Decimal @default(0.22) @db.Decimal(12, 4)
  /// Taxa media de cartao, como fracao do valor bruto pago pelo cliente.
  cardFeeRate   Decimal @default(0.012) @db.Decimal(12, 4)

  /// CMV desejado (custo primo / receita liquida). 0.30 = 30%.
  targetCmv    Decimal @default(0.30) @db.Decimal(12, 4)
  /// Lucro liquido alvo, como fracao da receita liquida.
  targetMargin Decimal @default(0.15) @db.Decimal(12, 4)

  rounding RoundingStrategy @default(NONE)

  /// Faturacao mensal esperada, **com IVA**, como o cliente paga.
  ///
  /// So serve para calcular a percentagem de custos fixos a partir das
  /// despesas lancadas, quando ainda nao ha vendas registadas de onde a tirar.
  /// Nulo significa "usar o que as vendas disserem".
  expectedMonthlyRevenue Decimal? @db.Decimal(12, 2)

  businessName String?

  /// Casas decimais das quantidades e dos custos por kg/L/un no ecra: 4
  /// ("automatico", o que sempre foi) ou 2. So a leitura muda — as contas, a
  /// base e a exportacao guardam a precisao toda.
  displayDecimals Int @default(4)

  /// Quantos dias depois da entrega se pergunta ao cliente se gostou.
  followUpDays    Int     @default(2)
  /// A mensagem do WhatsApp do pos-venda, com {nome}, {produtos} e {dia}.
  /// Nulo usa a mensagem que vem com a app (`MENSAGEM_POS_VENDA`).
  followUpMessage String?

  // ---- Cardapio publico (/cardapio) -------------------------------------
  /// Numero de WhatsApp da casa, so digitos com indicativo ("351912345678").
  /// Sem ele o cardapio publico nao mostra o botao de encomendar.
  whatsappNumber  String?
  /// Instagram da casa, so o nome de utilizador ("amobrigs").
  instagramHandle String?
  /// Facebook da casa: o nome de utilizador ou "profile.php?id=123".
  facebookHandle  String?
  /// O texto do topo do cardapio publico ("Bolos e brigadeiros por encomenda").
  menuIntro       String?
  /// Desligado, o link publico diz "voltamos em breve" e nao mostra nada.
  menuPublished   Boolean @default(false)

  updatedAt DateTime @updatedAt
}

/// Os catorze alergenios do Anexo II do Regulamento (UE) 1169/2011.
///
/// A lista e fechada e fixada por lei: nao e um campo livre nem um catalogo a
/// crescer. Os nomes seguem o regulamento, e nao o que se diz na cozinha.
enum Allergen {
  /// Cereais que contem gluten: trigo, centeio, cevada, aveia, espelta, kamut.
  GLUTEN
  CRUSTACEOS
  OVOS
  PEIXES
  AMENDOINS
  SOJA
  /// Leite, incluindo lactose.
  LEITE
  /// Frutos de casca rija: amendoas, avelas, nozes, cajus, pecans, castanhas
  /// do Brasil, pistacios, macadamias.
  FRUTOS_CASCA_RIJA
  AIPO
  MOSTARDA
  SESAMO
  /// Dioxido de enxofre e sulfitos acima de 10 mg/kg.
  SULFITOS
  TREMOCO
  MOLUSCOS
}

/// Com que frequencia uma despesa fixa chega.
enum ExpensePeriod {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

/// Familia da despesa. Serve para agrupar no ecra e, sobretudo, para a lista
/// de sugestoes lembrar o que costuma ficar esquecido.
enum ExpenseCategory {
  RENT
  UTILITIES
  LABOUR
  SERVICES
  TAXES
  MARKETING
  OTHER
}

/// Uma conta que se paga haja ou nao vendas.
///
/// A soma destas, dividida pela receita liquida de um mes, e a percentagem
/// que o motor de precos usa como custo fixo. Ate existirem, essa percentagem
/// e um palpite — e como ela e um termo da equacao do preco, o palpite
/// propaga-se a todos os precos da casa.
model Expense {
  id   String @id @default(cuid())
  name String

  /// Valor no periodo indicado, nao ja mensalizado. Guardar 600/ano em vez de
  /// 50/mes deixa a linha reconhecivel para quem a lancou.
  amount Decimal       @db.Decimal(12, 2)
  period ExpensePeriod @default(MONTHLY)

  category ExpenseCategory @default(OTHER)

  /// Desligada fica na lista e nao conta. Serve para simular sem apagar
  /// historico: "e se eu deixar de pagar isto?".
  active Boolean @default(true)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

// ---------------------------------------------------------------------------
// Modulo 1 — Insumos, embalagens e fornecedores
// ---------------------------------------------------------------------------

model Supplier {
  id      String  @id @default(cuid())
  name    String  @unique
  notes   String?
  /// Loja/URL de referencia para consulta de precos.
  url     String?
  /// Morada da loja. Serve para ordenar a volta das compras.
  address String?
  /// Telefone de contacto para encomendas.
  phone   String?

  ingredients   Ingredient[]
  offers        SupplierOffer[]
  shoppingItems ShoppingItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ingredient {
  id       String             @id @default(cuid())
  name     String
  category IngredientCategory @default(FOOD)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  /// Preco pago pela embalagem de compra inteira. Ex: 12.50
  purchasePrice Decimal      @db.Decimal(12, 4)
  /// Tamanho da embalagem de compra. Ex: 5 (kg)
  purchaseQty   Decimal      @db.Decimal(12, 4)
  purchaseUnit  PurchaseUnit
  /// Unidade base derivada de purchaseUnit. Denormalizada para consultas.
  baseUnit      BaseUnit

  /// Fator de correcao = peso bruto / peso liquido. 1 = sem perda.
  /// Ex: 1.25 significa 20% de perda na limpeza.
  correctionFactor Decimal @default(1) @db.Decimal(12, 4)

  /// Estoque atual na unidade base.
  ///
  /// E a soma dos movimentos, mantida em cache: recalcular somando a tabela
  /// de movimentos a cada leitura seria caro numa pagina que mostra 80
  /// insumos. Escreve-se sempre na mesma transacao do movimento, e a
  /// contagem de inventario serve justamente para o reconciliar com o mundo.
  stockBase Decimal @default(0) @db.Decimal(12, 4)

  /// Custo medio ponderado por unidade base do que esta em estoque.
  ///
  /// Diferente de `purchasePrice / purchaseQty`: aquele e o preco da proxima
  /// compra, este e o custo do que ja esta no armazem. Quando entra carne
  /// mais cara, o custo do que la estava dilui-se no novo — e e por este
  /// valor que se mede o que saiu.
  avgCostBase Decimal @default(0) @db.Decimal(12, 6)

  /// Alergenios que este insumo contem, do Anexo II do Reg. (UE) 1169/2011.
  ///
  /// Lista vazia **nao** quer dizer "nao tem": quer dizer o mesmo que
  /// `allergensReviewed = false` diria, se ninguem tiver olhado. Ver o campo
  /// seguinte — a diferenca entre "nao tem" e "ninguem verificou" e a unica
  /// coisa que interessa num aviso de alergenios.
  allergens Allergen[]

  /// Alguem ja olhou para os alergenios deste insumo.
  ///
  /// Sem isto, uma ficha de um produto que leva farinha e ovos mostraria
  /// "sem alergenios" enquanto ninguem preenchesse nada — e essa e a pior
  /// resposta possivel, porque parece informacao e e ausencia dela.
  allergensReviewed Boolean @default(false)

  /// Saldo abaixo do qual a aplicacao avisa. Nulo significa "nao avisar".
  ///
  /// Nulo e nao zero de proposito: um minimo por insumo e trabalho de quem
  /// cadastra, e obrigar a preencher isto em todos antes de a aplicacao
  /// servir para alguma coisa seria trocar um problema por outro. Quem quiser
  /// o aviso define o minimo; quem nao quiser nao e incomodado.
  minStockBase Decimal? @db.Decimal(12, 4)

  sku   String?
  notes String?

  recipeItems          RecipeItem[]
  packagingFor         Recipe[]           @relation("MainPackaging")
  deliveryPackagingFor Recipe[]           @relation("DeliveryPackaging")
  quotes               PriceQuote[]
  purchaseLines        PurchaseListLine[]
  movements            StockMovement[]
  offers               SupplierOffer[]
  shoppingItems        ShoppingItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, supplierId])
  @@index([category])
}

/// Cotacao historica de preco (Modulo 1: consulta de supermercados PT).
/// Nunca sobrescreve o Ingredient: quem decide aplicar e o usuario.
model PriceQuote {
  id           String     @id @default(cuid())
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  source QuoteSource
  /// Nome do produto como aparece na fonte.
  label  String?
  price  Decimal      @db.Decimal(12, 4)
  qty    Decimal      @db.Decimal(12, 4)
  unit   PurchaseUnit
  url    String?

  capturedAt DateTime @default(now())

  @@index([ingredientId, capturedAt])
}

// ---------------------------------------------------------------------------
// Modulo 2 — Fichas tecnicas e preparacoes base
// ---------------------------------------------------------------------------

model Recipe {
  id          String     @id @default(cuid())
  name        String     @unique
  kind        RecipeKind @default(PRODUCT)
  description String?

  /// Rendimento do lote. PRODUCT: numero de porcoes (yieldUnit = UN).
  /// BASE: rendimento em G/ML do lote inteiro.
  yieldQty  Decimal  @db.Decimal(12, 4)
  yieldUnit BaseUnit @default(UN)

  /// Embalagem principal, cobrada por porcao.
  packagingId String?
  packaging   Ingredient? @relation("MainPackaging", fields: [packagingId], references: [id], onDelete: SetNull)

  /// Embalagem extra de transporte, cobrada por porcao nos canais de entrega.
  deliveryPackagingId String?
  deliveryPackaging   Ingredient? @relation("DeliveryPackaging", fields: [deliveryPackagingId], references: [id], onDelete: SetNull)

  /// Foto do produto no Vercel Blob (store privado): o caminho, nao o URL. So
  /// se ve atraves de `/api/fotos/<id>`, que exige sessao — um URL do store
  /// privado nao abre sem o token.
  ///
  /// O caminho leva um sufixo aleatorio, e muda a cada foto nova: e isso que
  /// deixa o browser guardar a foto em cache para sempre sem nunca mostrar a
  /// antiga.
  photoPath      String?
  /// A mesma foto em pequeno (320 px), para as listas.
  photoThumbPath String?

  pricingMode  PricingMode @default(TARGET_CMV)
  /// Preco de balcao definido a mao quando pricingMode = MANUAL.
  manualPrice  Decimal?    @db.Decimal(12, 4)
  /// Sobrescreve Settings.targetCmv para este produto.
  targetCmv    Decimal?    @db.Decimal(12, 4)
  /// Sobrescreve Settings.targetMargin para este produto.
  targetMargin Decimal?    @db.Decimal(12, 4)

  customerOrderLines CustomerOrderLine[]
  /// Receitas do livro que descrevem esta ficha.
  bookRecipes        BookRecipe[]
  items              RecipeItem[]          @relation("RecipeOwner")
  /// Onde esta receita e usada como sub-receita.
  usedIn             RecipeItem[]          @relation("RecipeChild")
  orderLines         ProductionOrderLine[]
  /// O que o calendario diz deste produto em cada data ("nao produzir a 12/10").
  calendarPlans      CalendarPlanItem[]
  /// O item do cardapio publico que mostra esta ficha (no maximo um).
  menuItem           MenuItem?
  /// Os combos do cardapio que levam esta ficha.
  inCombos           MenuComboItem[]
  /// Os cupoes que se aplicam a esta ficha.
  coupons            CouponRecipe[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
}

/// Linha da ficha tecnica. Aponta para um Ingredient OU para outra Recipe
/// (sub-receita), nunca para os dois.
model RecipeItem {
  id       String @id @default(cuid())
  recipeId String
  recipe   Recipe @relation("RecipeOwner", fields: [recipeId], references: [id], onDelete: Cascade)

  ingredientId String?
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  childRecipeId String?
  childRecipe   Recipe? @relation("RecipeChild", fields: [childRecipeId], references: [id], onDelete: Restrict)

  /// Quantidade na unidade informada (convertida para base no calculo).
  qty  Decimal      @db.Decimal(12, 4)
  unit PurchaseUnit

  sortOrder Int     @default(0)
  notes     String?

  @@index([recipeId])
  @@index([childRecipeId])
}

// ---------------------------------------------------------------------------
// Modulo 3 — Canais de venda
// ---------------------------------------------------------------------------

model SalesChannel {
  id   String      @id @default(cuid())
  name String      @unique
  kind ChannelKind

  /// Comissao da plataforma sobre o valor bruto. 0.30 = 30%.
  commissionRate        Decimal  @default(0) @db.Decimal(12, 4)
  /// Custo fixo de entrega por pedido (entregador proprio, em moeda).
  deliveryCost          Decimal  @default(0) @db.Decimal(12, 4)
  /// Sobrescreve Settings.cardFeeRate neste canal (plataformas costumam ja
  /// embutir o pagamento na comissao -> 0).
  cardFeeRate           Decimal? @db.Decimal(12, 4)
  /// Cobra a embalagem extra de transporte.
  usesDeliveryPackaging Boolean  @default(false)

  customerOrders CustomerOrder[]

  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Modulo 4 — Producao e lista de compras (schema pronto; UI na fase 2)
// ---------------------------------------------------------------------------

model ProductionOrder {
  id    String    @id @default(cuid())
  name  String
  notes String?
  /// Data alvo da producao.
  dueAt DateTime?

  /// Quando a compra desta ordem deu entrada no estoque. Enquanto for nulo,
  /// o botao de receber continua disponivel; depois de preenchido, receber
  /// outra vez duplicaria o estoque.
  receivedAt DateTime?
  /// Quando a producao foi executada e os insumos sairam do estoque.
  producedAt DateTime?

  /// Producao para oferecer: amostras, evento, caixa de correio.
  ///
  /// Sai do estoque como qualquer outra, mas os movimentos ficam marcados
  /// como PROMO e nao entram no CMV real — entram como custo de divulgacao.
  /// Sem esta separacao, uma campanha de amostras fazia o CMV disparar e
  /// mandava procurar um problema que nao existe.
  promotional Boolean @default(false)

  lines          ProductionOrderLine[]
  listLines      PurchaseListLine[]
  movements      StockMovement[]
  /// Encomendas de clientes que esta ordem produz.
  customerOrders CustomerOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductionOrderLine {
  id      String          @id @default(cuid())
  orderId String
  order   ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Restrict)

  /// Quantidade de porcoes a produzir.
  qty Decimal @db.Decimal(12, 4)

  @@index([orderId])
}

/// Resultado congelado da explosao de insumos (MRP) de uma ordem.
model PurchaseListLine {
  id      String          @id @default(cuid())
  orderId String
  order   ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  /// Necessidade bruta na unidade base (ja com fator de correcao).
  requiredBase Decimal @db.Decimal(12, 4)
  /// Estoque considerado no momento do calculo.
  stockBase    Decimal @db.Decimal(12, 4)
  /// Falta a comprar, na unidade base.
  missingBase  Decimal @db.Decimal(12, 4)
  /// Embalagens de compra a adquirir (arredondado para cima).
  packsToBuy   Decimal @db.Decimal(12, 4)

  estimatedCost Decimal @db.Decimal(12, 4)

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Estoque — livro de movimentos
// ---------------------------------------------------------------------------

/// Cada mexida no estoque, com o seu porque.
///
/// O `Ingredient.stockBase` e a soma destes registos. Guardar o livro e nao
/// so o saldo e o que permite responder a "porque e que diz 3 kg?" — sem
/// isto, um numero errado no armazem nao tem como ser investigado.
model StockMovement {
  id           String     @id @default(cuid())
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  kind MovementKind

  /// Quantidade na unidade base, **com sinal**: positiva entra, negativa sai.
  qtyBase Decimal @db.Decimal(12, 4)

  /// Custo por unidade base no momento do movimento. Nas entradas e o preco
  /// pago; nas saidas e o custo medio de entao. Guardado porque o custo medio
  /// muda a cada compra e um relatorio de ontem nao pode mudar hoje.
  unitCost Decimal @db.Decimal(12, 6)
  /// `qtyBase * unitCost`. Denormalizado para somar periodos sem multiplicar.
  value    Decimal @db.Decimal(12, 4)

  /// Ordem de producao que originou o movimento, quando houve uma.
  orderId String?
  order   ProductionOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  note String?

  /// Quando aconteceu no mundo, que pode nao ser quando foi registado.
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([ingredientId, occurredAt])
  @@index([kind, occurredAt])
  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Precos por fornecedor
// ---------------------------------------------------------------------------

/// Quanto um fornecedor cobra por um insumo.
///
/// O `Ingredient` continua a ter o seu proprio preco: e esse que alimenta
/// todos os custos da aplicacao, e e o preco que a casa esta de facto a
/// pagar. Estas ofertas sao alternativas para comparar — adotar uma copia o
/// preco para o insumo, num gesto explicito.
///
/// Separar as duas coisas evita a armadilha de o custo de todas as fichas
/// mudar sozinho porque alguem anotou um preco de outro fornecedor.
model SupplierOffer {
  id           String     @id @default(cuid())
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  /// Nulo quando se sabe o preco mas nao de onde veio. E permitido um unico
  /// preco sem fornecedor por insumo — a action recusa o segundo.
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  /// Preco da embalagem inteira neste fornecedor.
  purchasePrice Decimal      @db.Decimal(12, 4)
  /// Tamanho da embalagem **deste** fornecedor, que pode nao ser o mesmo.
  purchaseQty   Decimal      @db.Decimal(12, 4)
  purchaseUnit  PurchaseUnit

  /// Referencia do produto no fornecedor.
  sku   String?
  notes String?

  /// O preco que a aplicacao usa de facto.
  ///
  /// E ele que alimenta o custo de todas as fichas tecnicas e que a lista de
  /// compras recomenda. Exatamente um por insumo, garantido pelas actions.
  ///
  /// Ser uma escolha explicita e o ponto: anotar o preco de outro fornecedor
  /// so para comparar nao pode mudar o custo dos produtos sem se mandar.
  inUse  Boolean @default(false)
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ingredientId, supplierId])
  @@index([ingredientId, inUse])
}

// ---------------------------------------------------------------------------
// Compras (a aba do comprador)
// ---------------------------------------------------------------------------

/// Uma lista de compras propria, que nao depende do que se vai produzir.
///
/// A lista da ordem de producao continua onde esta; esta e a do comprador —
/// "Semana 40", "Makro sabado" — e pode receber itens de uma ordem, do que
/// esta abaixo do minimo, ou escolhidos a mao.
model ShoppingList {
  id    String  @id @default(cuid())
  name  String
  notes String?

  /// Preenchido ao fechar: o que foi comprado deu entrada no estoque. Uma
  /// lista fechada ja nao se edita — corrigir e com um ajuste no Estoque.
  closedAt DateTime?

  /// Ordens de producao ja juntadas a esta lista. Juntar a mesma duas vezes
  /// somava tudo a dobrar sem nada a avisar.
  orderIds String[] @default([])

  items ShoppingItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([closedAt])
}

enum ShoppingItemStatus {
  PENDING
  BOUGHT
  MISSING
}

/// Um insumo a comprar. Nasce com o preco, a loja e a embalagem do preco em
/// uso; o comprador corrige-os no supermercado se forem outros.
model ShoppingItem {
  id     String       @id @default(cuid())
  listId String
  list   ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)

  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  /// Quantas embalagens.
  packs Decimal @db.Decimal(12, 4)

  /// A loja, o preco da embalagem e o tamanho dela — os de agora, que o
  /// comprador pode ter corrigido.
  supplierId String?
  supplier   Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  price      Decimal      @db.Decimal(12, 4)
  packQty    Decimal      @db.Decimal(12, 4)
  packUnit   PurchaseUnit

  /// Preco por unidade base do preco em uso quando o item entrou, para se ver
  /// "pagou 3,20 EUR/kg em vez de 3,45". Nulo se o insumo nao tinha preco.
  refPricePerBase Decimal? @db.Decimal(12, 6)

  status ShoppingItemStatus @default(PENDING)

  /// O comprador marcou "usar este preco daqui para a frente". Sem isto, o
  /// preco novo fica registado para a loja mas nao muda o custo das fichas.
  useAsCurrent Boolean @default(false)

  note      String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listId])
  @@index([ingredientId])
}

// ---------------------------------------------------------------------------
// Encomendas — a venda, tal como a casa trabalha: por pedido do cliente
// ---------------------------------------------------------------------------

/// Quem encomenda.
///
/// Guardar o nome e o telefone para entregar a encomenda e execucao do
/// contrato e nao precisa de consentimento. Voltar a contactar depois —
/// perguntar se gostou, avisar de novidades — precisa (RGPD), e por isso
/// ha um campo proprio, com a data em que foi dado.
model Customer {
  id    String  @id @default(cuid())
  name  String
  phone String?
  notes String?

  /// Redes sociais: so o nome de utilizador ("ana.doces"), sem @ nem link —
  /// o link faz-se na hora (`linkRede`). Um perfil do Facebook sem nome de
  /// utilizador fica "profile.php?id=123".
  instagram String?
  facebook  String?
  tiktok    String?

  /// Quando o cliente aceitou ser contactado depois da venda. Nulo: nao aceitou
  /// (ou nao foi perguntado), e o pos-venda nao lhe pode escrever.
  contactConsentAt DateTime?

  /// Aniversario, sem o ano: chega para o lembrete, e ninguem tem de dizer a idade.
  birthDay   Int?
  birthMonth Int?

  /// Por onde nos conheceu.
  source       CustomerSource?
  /// Quem o indicou, quando veio por indicacao.
  referredById String?
  referredBy   Customer?       @relation("Indicacoes", fields: [referredById], references: [id], onDelete: SetNull)
  referrals    Customer[]      @relation("Indicacoes")

  /// Gostos, em texto livre: "chocolate amargo, frutos vermelhos".
  ///
  /// **Alergias e doencas nao vao aqui.** Sao dados de saude (art. 9 do
  /// RGPD), com regras mais apertadas; ficam nas notas de cada encomenda,
  /// que e onde a cozinha precisa delas.
  likes    String?
  dislikes String?

  orders    CustomerOrder[]
  reminders Reminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([phone])
}

enum CustomerSource {
  INSTAGRAM
  FACEBOOK
  WHATSAPP
  REFERRAL
  WALK_IN
  EVENT
  OTHER
}

/// Como foi feito o contacto de pos-venda.
enum ContactVia {
  PHONE
  WHATSAPP
  IN_PERSON
}

enum CustomerOrderStatus {
  /// Combinada com o cliente, ainda nao foi para producao.
  REQUESTED
  IN_PRODUCTION
  READY
  /// So aqui conta como venda.
  DELIVERED
  CANCELLED
}

enum Fulfillment {
  PICKUP
  DELIVERY
}

enum PaymentMethod {
  CASH
  MBWAY
  CARD
  TRANSFER
}

/// Uma encomenda. E a venda: conta para as Vendas quando e entregue.
model CustomerOrder {
  id     String @id @default(cuid())
  /// "Encomenda 12" — mais facil de dizer ao telefone do que um cuid.
  number Int    @unique @default(autoincrement())

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  /// Por onde chegou: balcao, entrega propria, plataforma. Decide a comissao
  /// e o frete nas contas.
  channelId String?
  channel   SalesChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  status CustomerOrderStatus @default(REQUESTED)

  /// Dia e hora da entrega, **em hora de Portugal guardada como se fosse UTC**
  /// (o que o <input type="datetime-local"> escreve). Mostra-se sempre com
  /// timeZone UTC: assim "15:00" e 15:00 no servidor da Vercel e no telemovel.
  dueAt       DateTime
  fulfillment Fulfillment @default(PICKUP)
  address     String?
  notes       String?

  paid          Boolean        @default(false)
  paymentMethod PaymentMethod?

  /// Quando foi entregue — e o dia que conta para o mes das Vendas.
  deliveredAt DateTime?

  /// A ordem de producao onde esta encomenda entrou.
  productionOrderId String?
  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id], onDelete: SetNull)

  // ---- Pos-venda --------------------------------------------------------
  /// Quando perguntar se gostou. Marca-se ao entregar, so para quem deu
  /// consentimento; "nao atendeu" passa-o para o dia seguinte; "nao
  /// contactar" limpa-o. Nulo e sem `feedbackAt`: nao ha nada a fazer.
  followUpDueAt    DateTime?
  followUpAttempts Int         @default(0)
  /// Preenchido quando o cliente respondeu: o pos-venda desta encomenda acabou.
  feedbackAt       DateTime?
  feedbackVia      ContactVia?
  /// Nota geral, de 1 a 5.
  rating           Int?
  feedbackComment  String?

  // ---- Cupao ------------------------------------------------------------
  /// O cupao usado. Conta para os limites de uso enquanto a encomenda nao
  /// estiver cancelada.
  couponId       String?
  coupon         Coupon?  @relation(fields: [couponId], references: [id], onDelete: SetNull)
  /// O codigo no dia, para o historico sobreviver ao cupao ser apagado.
  couponCode     String?
  /// Quanto o cupao tirou, ao todo (ja descontado nos `unitPrice` das linhas).
  couponDiscount Decimal? @db.Decimal(12, 4)

  lines     CustomerOrderLine[]
  reminders Reminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, dueAt])
  @@index([deliveredAt])
  @@index([customerId])
  @@index([followUpDueAt])
  @@index([couponId])
}

/// Um produto da encomenda, com o preco combinado.
///
/// O custo fica congelado no dia em que a linha entrou: se a farinha subir
/// amanha, o lucro da encomenda de ontem nao muda.
model CustomerOrderLine {
  id      String        @id @default(cuid())
  orderId String
  order   CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Restrict)

  qty Decimal @db.Decimal(12, 4)

  /// Preco por unidade combinado com o cliente, na convencao de IVA das
  /// configuracoes (o mesmo que o preco de tabela).
  unitPrice Decimal  @db.Decimal(12, 4)
  /// O preco de tabela quando a linha entrou, para mostrar o desconto.
  listPrice Decimal? @db.Decimal(12, 4)

  /// Custos por unidade no dia em que a linha entrou.
  unitFoodCost              Decimal @db.Decimal(12, 4)
  unitPackagingCost         Decimal @db.Decimal(12, 4)
  unitDeliveryPackagingCost Decimal @db.Decimal(12, 4)

  notes String?

  /// Nota do cliente a este produto, de 1 a 5. Opcional: a geral fica na encomenda.
  rating Int?

  /// A promocao que deu o preco desta linha, se houve.
  promotionId    String?
  promotion      Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  /// O item do cardapio de onde veio: o proprio produto, ou o combo que se
  /// desdobrou nesta e noutras linhas.
  menuItemId     String?
  menuItem       MenuItem?  @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  /// A parte do cupao nesta linha, ao todo (nao por unidade). Ja esta
  /// descontada no `unitPrice`.
  couponDiscount Decimal?   @db.Decimal(12, 4)

  @@index([orderId])
  @@index([recipeId])
}

/// Uma coisa a fazer num dia: "ligar ao Rui sobre o bolo de casamento".
///
/// So os lembretes escritos a mao vivem aqui. Os automaticos — pos-venda
/// por fazer, aniversarios — calculam-se na hora a partir das encomendas e
/// dos clientes, para nunca ficarem desencontrados deles.
model Reminder {
  id    String   @id @default(cuid())
  title String
  notes String?
  /// O dia (e a hora, se houver), em hora de Lisboa guardada como UTC.
  dueAt DateTime

  customerId String?
  customer   Customer?      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId    String?
  order      CustomerOrder? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  doneAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([doneAt, dueAt])
  @@index([customerId])
}

// ---------------------------------------------------------------------------
// Utilizadores
// ---------------------------------------------------------------------------

/// O que cada pessoa pode fazer.
enum UserRole {
  /// Tudo: custos, encomendas, configuracoes, utilizadores, apagar de vez.
  OWNER
  /// O livro de receitas: ver, criar e alterar (cada alteracao e uma versao).
  /// Nao ve custos nem margens.
  KITCHEN
  /// O livro de receitas, so para ler e imprimir.
  READER
}

/// Uma pessoa com conta.
///
/// A palavra-passe guarda-se so como hash scrypt (ver `lib/auth.ts`). As
/// tentativas falhadas contam-se por conta, e a quinta seguida bloqueia-a
/// por 15 minutos.
model User {
  id           String   @id @default(cuid())
  /// Nome com que se entra, em minusculas.
  username     String   @unique
  name         String
  role         UserRole @default(READER)
  passwordHash String
  active       Boolean  @default(true)

  /// Vai no cookie. Subir este numero termina todas as sessoes desta pessoa
  /// (trocar a palavra-passe, "sair de todos os aparelhos", desativar).
  sessionVersion Int @default(0)

  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?

  /// Obriga a trocar a palavra-passe no proximo acesso (contas criadas ou
  /// repostas pelo dono, com uma palavra-passe que ele conhece).
  mustChangePassword Boolean @default(false)

  bookVersions BookRecipeVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Livro de receitas
// ---------------------------------------------------------------------------

/// De onde veio a receita.
enum RecipeSourceKind {
  FAMILY
  COURSE
  BOOK
  INTERNET
  OWN
  OTHER
}

/// Um livro: "Receitas da familia", "Curso de confeitaria".
model Cookbook {
  id          String  @id @default(cuid())
  title       String
  subtitle    String?
  description String?

  entries CookbookEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Uma receita num livro, na seccao e ordem desse livro. A mesma receita pode
/// estar em varios livros.
model CookbookEntry {
  id         String     @id @default(cuid())
  cookbookId String
  cookbook   Cookbook   @relation(fields: [cookbookId], references: [id], onDelete: Cascade)
  recipeId   String
  recipe     BookRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  /// "Bolos", "Recheios" — texto livre; agrupa no indice e na impressao.
  section   String?
  sortOrder Int     @default(0)

  @@unique([cookbookId, recipeId])
  @@index([recipeId])
}

/// Uma receita do livro. O conteudo vive nas versoes; aqui fica o que nao
/// muda de versao para versao: o titulo, a origem, as etiquetas.
model BookRecipe {
  id    String @id @default(cuid())
  title String

  sourceKind     RecipeSourceKind?
  /// "Avo Maria", "Curso X, modulo 3", "Livro Y, p. 42".
  sourceName     String?
  sourceUrl      String?
  /// O ficheiro de onde foi importada (PDF), no Blob privado.
  sourceFilePath String?
  sourceFileName String?

  tags String[] @default([])

  /// Foto do prato, no Blob privado (o caminho, nao o URL), e a miniatura das
  /// listas. Como as das fichas: servidas por `/api/receitas/<id>/foto`.
  photoPath      String?
  photoThumbPath String?

  /// A ficha tecnica que esta receita descreve, para os custos.
  fichaId String?
  ficha   Recipe? @relation(fields: [fichaId], references: [id], onDelete: SetNull)

  /// O numero da versao em uso. A 1 e sempre a original.
  currentVersion Int @default(1)

  /// Arquivada: sai da busca e dos livros, mas nao se perde. So o dono apaga de vez.
  archivedAt DateTime?

  versions BookRecipeVersion[]
  entries  CookbookEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([archivedAt])
}

/// Uma versao de uma receita. Nunca se altera: mudar a receita e criar a
/// versao seguinte. A 1 e a original, tal como veio da fonte.
model BookRecipeVersion {
  id       String     @id @default(cuid())
  recipeId String
  recipe   BookRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  number   Int

  /// Uma linha por ingrediente.
  ingredients String
  /// Um passo por paragrafo.
  steps       String
  yield       String?
  prepTime    String?
  notes       String?

  /// Porque mudou: "menos acucar, ficava doce demais".
  changeNote String?

  authorId   String?
  author     User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  /// O nome no momento: se a conta for apagada, a autoria fica.
  authorName String

  createdAt DateTime @default(now())

  @@unique([recipeId, number])
}

// ---------------------------------------------------------------------------
// Seguranca: tentativas de entrada e registo de alteracoes
// ---------------------------------------------------------------------------

/// Tentativas falhadas de entrar, por origem (endereco IP).
///
/// O bloqueio por conta (`User.failedLogins`) nao apanha quem tenta uma
/// palavra-passe comum em todas as contas, uma vez cada. Isto apanha: muitas
/// falhas da mesma origem, em qualquer conta, bloqueiam a origem.
model LoginThrottle {
  /// O endereco, ja resumido (ver `lib/auth.ts`).
  key         String    @id
  failures    Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

/// Quem mudou o que, e quando.
///
/// So acrescenta: nada na app altera ou apaga uma linha daqui. Guarda o nome
/// da pessoa no momento, para o registo sobreviver a conta ser apagada.
model AuditLog {
  id       String   @id @default(cuid())
  at       DateTime @default(now())
  userId   String?
  userName String
  /// "entrar", "configuracoes.guardar", "receita.apagar"…
  action   String
  /// O que foi mexido, legivel: "Bolo de cenoura", "Encomenda 12".
  target   String?
  /// Pormenor curto: valores antes e depois, motivo.
  detail   String?

  @@index([at])
  @@index([action])
}

// ---------------------------------------------------------------------------
// Calendario de producao
// ---------------------------------------------------------------------------

/// Que tipo de evento o dono marcou.
enum CalendarEventKind {
  /// Festa, feira, encomenda grande.
  EVENT
  /// Algo que esta na moda e vale a pena aproveitar.
  TREND
  /// Da equipa: folga, ferias, formacao.
  TEAM
}

/// O que fazer com um produto numa data.
enum CalendarPlanAction {
  MORE
  LESS
  NONE
}

/// Um evento do calendario.
///
/// Os feriados e as datas comemorativas nao vivem aqui: calculam-se em
/// `lib/calendario/datas.ts`. So ganham uma linha quando o dono lhes junta
/// alguma coisa (plano de producao, notas) — e entao `knownKey` diz qual e, e
/// o dia continua a vir do calculo, porque a Pascoa muda todos os anos.
model CalendarEvent {
  id       String            @id @default(cuid())
  /// A data conhecida que esta linha completa ("criancas-br"). Nulo nos eventos do dono.
  knownKey String?           @unique
  title    String
  /// O dia, nos eventos do dono. Nulo nas datas conhecidas.
  day      DateTime?         @db.Date
  /// Repete todos os anos no mesmo dia e mes. As datas conhecidas repetem sempre.
  yearly   Boolean           @default(false)
  kind     CalendarEventKind @default(EVENT)
  /// Para a equipa: o que preparar, quem esta de folga.
  notes    String?

  plans   CalendarPlanItem[]
  reviews CalendarReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([day])
}

/// Um produto no plano de uma data: produzir mais, menos, ou nao produzir.
model CalendarPlanItem {
  id       String             @id @default(cuid())
  eventId  String
  event    CalendarEvent      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  recipeId String
  recipe   Recipe             @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  action   CalendarPlanAction
  /// Quantas, quando se sabe ("mais 30").
  qty      Int?
  note     String?

  @@unique([eventId, recipeId])
}

/// Como correu um evento num ano: para o ano seguinte se lembrar.
model CalendarReview {
  id      String        @id @default(cuid())
  eventId String
  event   CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  year    Int
  text    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, year])
}

// ---------------------------------------------------------------------------
// Cardapio publico, promocoes e cupoes
// ---------------------------------------------------------------------------

/// Uma secao do cardapio: "Bolos", "Brigadeiros", "Kits".
enum MenuSectionLayout {
  /// Um item por linha: nome, descricao, preco ("Caseirinhos").
  LIST
  /// Cartoes lado a lado, para tamanhos ("16 cm · 14 a 16 fatias · 50 €").
  CARDS
  /// So texto, sem itens ("Informacoes importantes", "Cuidados extras").
  TEXT
  /// Cartoes com foto grande, dois por linha (caixas, kits).
  GALLERY
}

/// Uma secao do cardapio: "Bolos", "Caseirinhos", "Informacoes importantes".
///
/// Os textos seguem uma marcacao minima (`lib/cardapio/texto.ts`): "## " abre
/// um subtitulo, "- " um marcador, **assim** fica a negrito.
model MenuSection {
  id             String            @id @default(cuid())
  name           String
  layout         MenuSectionLayout @default(LIST)
  position       Int               @default(0)
  /// Escondida do link publico sem a apagar.
  published      Boolean           @default(true)
  /// O texto antes dos itens ("Todos os nossos bolos possuem 4 camadas...").
  description    String?
  /// O titulo por cima dos itens ("Tamanho e valores", "Sabores").
  itemsTitle     String?
  /// Nota pequena depois dos itens ("*Valor da massa... exceto decoracao").
  footnote       String?
  /// Faixa de destaque ("Bolos de dois andares, valores sob consulta").
  highlight      String?
  /// O texto depois dos itens: massas, recheios, decoracao; numa secao TEXT,
  /// e a secao toda.
  body           String?
  /// Foto de capa, por baixo do titulo. Blob privado (como as fichas),
  /// servida por `/api/cardapio/foto/secao/<id>`.
  photoPath      String?
  photoThumbPath String?
  items          MenuItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum MenuItemKind {
  /// Uma ficha tecnica a venda.
  PRODUCT
  /// Varias fichas a um preco fixo ("bolo + 6 brigadeiros").
  COMBO
}

/// O que o cliente ve no link publico.
///
/// O preco e PROPRIO: comeca igual ao de tabela, mas nao muda sozinho quando
/// os custos mudam — a app avisa e o dono decide. Esta na convencao de IVA das
/// configuracoes, como o preco de tabela; o publico ve-o sempre com IVA.
model MenuItem {
  id   String       @id @default(cuid())
  kind MenuItemKind @default(PRODUCT)

  sectionId String?
  section   MenuSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  /// PRODUCT: a ficha (foto, alergenios, custo). Nulo nos combos e num
  /// produto ainda sem ficha (so nome e preco): esse aparece no link publico,
  /// mas so entra nas encomendas depois de ligado a uma ficha.
  recipeId String? @unique
  recipe   Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  /// Vazios num produto: usam o nome e a descricao da ficha. Num combo, o
  /// nome e obrigatorio.
  name        String?
  description String?
  /// "un", "caixa de 12", "bolo de 1,2 kg".
  unitLabel   String?

  price      Decimal  @db.Decimal(12, 4)
  /// Quando o preco foi posto: o aviso diz "a tabela mudou desde".
  priceSetAt DateTime @default(now())

  /// Rascunho ate ser publicado.
  published      Boolean @default(false)
  /// Aparece, mas como "esgotado", sem se poder escolher.
  soldOut        Boolean @default(false)
  /// Foto propria do item; sem ela, usa a da ficha (ou, num combo, a da
  /// primeira ficha com foto). Ver `caminhoDaFoto`.
  photoPath      String?
  photoThumbPath String?

  /// "Sob consulta": aparece sem preco e nao entra no total da mensagem.
  priceOnRequest Boolean @default(false)
  position       Int     @default(0)

  components MenuComboItem[]
  promotions PromotionItem[]
  orderLines CustomerOrderLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId, position])
}

/// Uma ficha dentro de um combo, com a quantidade.
model MenuComboItem {
  id       String   @id @default(cuid())
  comboId  String
  combo    MenuItem @relation(fields: [comboId], references: [id], onDelete: Cascade)
  recipeId String
  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  qty      Decimal  @db.Decimal(12, 4)

  @@unique([comboId, recipeId])
}

enum PromotionKind {
  /// Percentagem sobre o preco (`value` = 0.15).
  PERCENT
  /// Valor tirado a cada unidade (`value` = 0.50).
  AMOUNT
  /// Leve `buyQty`, pague `payQty`.
  BUY_X_PAY_Y
  /// A partir de `minQty` unidades, cada uma a `value`.
  QTY_PRICE
}

/// Uma promocao sobre itens do cardapio, entre duas datas (dias de Lisboa,
/// ambos incluidos). Varias promocoes no mesmo item nao se somam: vale a que
/// fica mais barata ao cliente.
model Promotion {
  id     String        @id @default(cuid())
  name   String
  kind   PromotionKind
  value  Decimal?      @db.Decimal(12, 4)
  buyQty Int?
  payQty Int?
  minQty Decimal?      @db.Decimal(12, 4)

  startsAt DateTime  @db.Date
  /// Nulo: sem fim.
  endsAt   DateTime? @db.Date
  active   Boolean   @default(true)

  items      PromotionItem[]
  orderLines CustomerOrderLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PromotionItem {
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  menuItemId  String
  menuItem    MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@id([promotionId, menuItemId])
}

enum CouponKind {
  /// Percentagem sobre os produtos elegiveis (`value` = 0.10).
  PERCENT
  /// Valor tirado a encomenda, repartido pelos produtos elegiveis.
  AMOUNT
}

/// Um cupao de desconto. Valida-se na encomenda, dentro da app: o cardapio
/// publico so passa o codigo na mensagem do WhatsApp.
model Coupon {
  id   String @id @default(cuid())
  /// Sempre em maiusculas e sem espacos.
  code String @unique

  description String?
  kind        CouponKind
  value       Decimal    @db.Decimal(12, 4)
  /// Valor minimo da encomenda, na convencao de IVA das configuracoes.
  minOrder    Decimal?   @db.Decimal(12, 4)

  startsAt DateTime  @db.Date
  endsAt   DateTime? @db.Date

  /// Usos no total e por cliente. Nulo: sem limite.
  maxUses            Int?
  maxUsesPerCustomer Int?

  /// Toda a encomenda, ou so as fichas em `recipes`.
  allItems             Boolean @default(true)
  /// Desconta tambem nas linhas que ja tem promocao.
  stacksWithPromotions Boolean @default(false)
  active               Boolean @default(true)

  recipes CouponRecipe[]
  orders  CustomerOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CouponRecipe {
  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([couponId, recipeId])
}
