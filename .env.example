# Postgres (Neon / Supabase / Vercel Postgres).
# Neon: copie a "Pooled connection string" do dashboard.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# So isto e preciso. Se um dia quiser usar `prisma migrate` contra uma ligacao
# em pool, veja a seccao "Migrations" do README — envolve acrescentar
# DIRECT_URL e uma linha ao schema.
